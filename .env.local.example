# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nbe_arena?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/nbe_arena?retryWrites=true&w=majority

# NextAuth.js Authentication Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_32_character_jwt_secret_key

# Vision LLM Provider: 'openai' | 'anthropic' | 'google'
VISION_PROVIDER=openai

# Vision API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
